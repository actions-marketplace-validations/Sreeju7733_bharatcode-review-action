{
  "name": "bharatcode-review-action",
  "version": "1.0.0",
  "description": "Open-source GitHub Action for AI pull request code reviews by Flovo using BharatCode AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --minify --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size-check": "node scripts/check-size.js",
    "prepare": "npm run build"
  },
  "author": {
    "name": "Sreeju S",
    "url": "https://github.com/Sreeju7733"
  },
  "homepage": "https://github.com/flovo-labs",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^9.1.1",
    "js-yaml": "^4.1.0",
    "p-limit": "^5.0.0",
    "picomatch": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/picomatch": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "msw": "^2.6.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
